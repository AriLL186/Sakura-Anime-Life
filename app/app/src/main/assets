<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#f7d8ec">
<title>Sakura Anime Life</title>
<style>
:root{--pink:#f4b9dc;--deep:#a94f88;--blue:#bcecff;--ink:#563d58}
*{box-sizing:border-box}body{margin:0;background:#fff5fb;color:var(--ink);font-family:system-ui,-apple-system,sans-serif;user-select:none}
header{padding:12px 15px;background:linear-gradient(110deg,#f8c9e5,#c8edff);display:flex;align-items:center;justify-content:space-between;gap:8px;position:sticky;top:0;z-index:5;box-shadow:0 2px 10px #9a679022}
h1{font-size:19px;margin:0;color:#8d477e}.sub{font-size:11px;color:#765b78}
.pill{background:#ffffffc9;border-radius:20px;padding:7px 10px;font-size:12px;font-weight:800;white-space:nowrap}
main{max-width:680px;margin:auto;padding:12px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-bottom:10px}
.stat,.card{background:#fff;border:1px solid #f4d9eb;border-radius:16px;padding:10px;box-shadow:0 3px 12px #9a679012}
.stat{text-align:center;font-size:11px}.stat b{display:block;font-size:16px;color:#9b5389;margin-top:3px}
.scene{height:min(62vh,460px);min-height:330px;position:relative;overflow:hidden;border-radius:20px;border:2px solid #fff;box-shadow:0 5px 18px #91678a22;background:linear-gradient(#91d7f5 0%,#e7d9f5 66%,#9bcf91 67%,#72ad77 100%)}
.sun{position:absolute;right:22px;top:15px;font-size:35px}.cloud{position:absolute;font-size:34px;opacity:.8}.c1{left:18px;top:28px}.c2{left:55%;top:65px}
.school{position:absolute;bottom:34%;left:8%;width:84%;height:36%;background:#fff0e9;border:5px solid #e7c9dc;border-bottom:0;border-radius:9px 9px 0 0}
.school:before{content:"";position:absolute;inset:18px 12px 0;background:repeating-linear-gradient(90deg,#8fc9e8 0 34px,#fff 34px 48px);opacity:.9}
.school:after{content:"";position:absolute;left:43%;bottom:0;width:16%;height:65%;background:#d3a7c5;border:4px solid #fff}
.ground{position:absolute;bottom:0;width:100%;height:36%;background:repeating-linear-gradient(0deg,#e6cdbb 0 22px,#d8bba8 23px 25px);clip-path:polygon(0 10%,100% 10%,100% 100%,0 100%)}
.tree{position:absolute;bottom:30%;font-size:75px;filter:drop-shadow(0 3px 2px #725);}.t1{left:0}.t2{right:-3px}
.bench{position:absolute;bottom:23%;left:8%;font-size:35px}
.bubble{position:absolute;z-index:3;top:10px;left:50%;transform:translateX(-50%);background:#fff;border-radius:15px;padding:8px 12px;font-size:12px;text-align:center;width:max-content;max-width:88%;box-shadow:0 3px 12px #69445b25}
.aoi{position:absolute;z-index:2;bottom:2%;left:50%;width:clamp(145px,43%,230px);height:78%;object-fit:contain;object-position:bottom;transform:translateX(-50%);filter:drop-shadow(0 5px 4px #54364a40);transition:left .25s}
.place{text-align:center;font-weight:850;font-size:17px}.desc{text-align:center;font-size:12px;color:#866c85;margin-top:3px}
.section-title{font-weight:850;margin-bottom:8px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}
button{border:0;border-radius:13px;padding:11px 6px;background:#f7dcec;color:#633b5b;font-weight:800;font-size:12px;min-height:43px;touch-action:manipulation}
button:active{transform:scale(.97)}button.primary{background:#a94f88;color:white}
.card{margin-top:10px}.row{display:flex;gap:7px;flex-wrap:wrap}.row button{flex:1;min-width:90px}
.log{font-size:12px;line-height:1.5;min-height:35px}.small{font-size:10px;color:#987f96}
.controls{display:flex;justify-content:space-between;align-items:end;margin-top:9px;gap:10px}
.pad{display:grid;grid-template-columns:repeat(3,42px);grid-template-rows:repeat(2,38px);gap:3px}
.pad button{padding:0;background:#ffffffd9;border:1px solid #e8c7e1;font-size:18px}
.pad .empty{visibility:hidden}.action-stack{display:flex;flex-direction:column;gap:5px}
@media(min-width:600px){main{padding:18px}.scene{height:430px}}
</style>
</head>
<body>
<header><div><h1>🌸 Sakura Anime Life</h1><div class="sub">Petualangan kecil Aoi di kota Sakura</div></div><div class="pill" id="clock">Hari 1 · 08:00</div></header>
<main>
 <section class="stats">
  <div class="stat">💰 Uang<b id="money">¥500</b></div>
  <div class="stat">😊 Mood<b id="mood">80/100</b></div>
  <div class="stat">💗 Teman<b id="friends">0</b></div>
 </section>
 <section class="scene" id="scene">
  <div class="sun">☀️</div><div class="cloud c1">☁️</div><div class="cloud c2">☁️</div>
  <div class="school" id="building"></div><div class="tree t1" id="tree1">🌸</div><div class="tree t2" id="tree2">🌸</div>
  <div class="bench">🪑</div><div class="ground"></div>
  <div class="bubble" id="bubble">Selamat pagi! Ayo jalan-jalan! 🌸</div>
  <img class="aoi" id="aoi" src="aoi.png" alt="Aoi si catgirl">
 </section>
 <section class="card"><div class="place" id="place">Akademi Sakura</div><div class="desc" id="desc">Sekolah yang ramai dan penuh bunga sakura.</div></section>
 <section class="card">
  <div class="section-title">🗺️ Jelajahi kota</div>
  <div class="grid">
   <button data-place="home">🏡 Rumah</button><button data-place="school">🏫 Sekolah</button><button data-place="park">🌸 Taman</button>
   <button data-place="cafe">☕ Kafe</button><button data-place="shop">🛍️ Toko</button><button data-place="beach">🏖️ Pantai</button>
  </div>
 </section>
 <section class="card">
  <div class="section-title">✨ Aktivitas Aoi</div>
  <div class="row"><button id="talk">💬 Sapa teman</button><button id="work">🧹 Kerja</button><button id="rest">🧸 Istirahat</button></div>
 </section>
 <section class="card">
  <div class="section-title">🎀 Penampilan</div>
  <div class="row"><button data-look="normal">❄️ Aoi</button><button data-look="happy">😺 Senang</button><button data-look="wink">😉 Kedip</button></div>
 </section>
 <section class="card">
  <div class="section-title">🎮 Kontrol jalan</div>
  <div class="controls">
   <div class="pad"><span class="empty"></span><button id="up">▲</button><span class="empty"></span><button id="left">◀</button><button id="down">▼</button><button id="right">▶</button></div>
   <div class="action-stack"><button id="wave">👋 Melambaikan tangan</button><button id="dance">💃 Menari</button></div>
  </div>
  <div class="small">Gunakan tombol panah untuk menggerakkan Aoi di area permainan.</div>
 </section>
 <section class="card"><div class="section-title">📖 Catatan Aoi</div><div class="log" id="log">Aoi memulai petualangan barunya. Yuk cari teman!</div><div class="small">Progres tersimpan otomatis di perangkat ini.</div></section>
 <button class="primary" style="width:100%;margin-top:10px" id="newday">🌙 Akhiri hari & tidur</button>
</main>
<script>
(()=> {
const $=id=>document.getElementById(id);
const places={
 home:['Rumah Aoi','Rumah kecil yang nyaman di kota Sakura.','🏠','🌷'],
 school:['Akademi Sakura','Sekolah yang ramai dan penuh bunga sakura.','🏫','🌸'],
 park:['Taman Sakura','Kelopak bunga menari tertiup angin.','🌳','🌸'],
 cafe:['Kafe Momo','Aroma roti dan cokelat memenuhi ruangan.','☕','🌷'],
 shop:['Distrik Belanja','Banyak aksesori dan pakaian lucu.','🏬','🌳'],
 beach:['Pantai Biru','Ombak kecil berkilau di bawah matahari.','🏖️','🌴']
};
let s={money:500,mood:80,friends:0,day:1,hour:8,place:'school',x:50,look:'normal'};
try{const old=JSON.parse(localStorage.getItem('sakuraSaveV2'));if(old)s={...s,...old}}catch(e){}
function save(){try{localStorage.setItem('sakuraSaveV2',JSON.stringify(s))}catch(e){}}
function say(t){$('log').textContent=t;$('bubble').textContent=t}
function render(){
 $('money').textContent='¥'+s.money;$('mood').textContent=s.mood+'/100';$('friends').textContent=s.friends;
 $('clock').textContent='Hari '+s.day+' · '+String(s.hour).padStart(2,'0')+':00';
 $('place').textContent=places[s.place][0];$('desc').textContent=places[s.place][1];
 $('aoi').style.left=s.x+'%';
 $('aoi').style.transform='translateX(-50%)'+(s.look==='happy'?' scale(1.04)':s.look==='wink'?' scaleX(-1)':'');
 $('scene').style.background=s.place==='beach'?'linear-gradient(#8bd5f2 0%,#e2f5ff 60%,#f5d88e 61%,#e8c77e 100%)':s.place==='cafe'?'linear-gradient(#d9b6d3,#f1d5bd 65%,#a4b48a 66%)':'linear-gradient(#9bd7f1 0%,#e7d5f7 65%,#8dc78d 66%,#69a96c 100%)';
 $('building').style.display=['home','park','beach'].includes(s.place)?'none':'block';
 $('tree1').textContent=places[s.place][3];$('tree2').textContent=s.place==='beach'?'🌴':'🌸';
 save();
}
function advance(n=1){s.hour+=n;if(s.hour>=22){s.hour=22;say('Sudah malam. Saatnya pulang dan beristirahat. 🌙')}render()}
document.querySelectorAll('[data-place]').forEach(b=>b.onclick=()=>{if(s.hour>=22)return say('Sudah malam. Tidur dulu, ya!');s.place=b.dataset.place;s.x=50;advance(1);s.mood=Math.min(100,s.mood+2);say('Aoi pergi ke '+places[s.place][0]+' ✨');render()});
$('talk').onclick=()=>{if(s.hour>=22)return say('Sudah terlalu malam untuk berkunjung.');s.friends++;s.mood=Math.min(100,s.mood+8);advance(1);say(['Kamu bertemu teman baru! 💗','Obrolan seru membuat Aoi tersenyum! 😊','Temanmu mengajak jalan-jalan lagi! 🌸'][s.friends%3]);render()};
$('work').onclick=()=>{if(s.hour>=20)return say('Toko sudah tutup. Coba lagi besok!');s.money+=120;s.mood=Math.max(0,s.mood-8);advance(2);say('Aoi bekerja paruh waktu dan mendapat ¥120. Semangat!');render()};
$('rest').onclick=()=>{s.mood=Math.min(100,s.mood+18);advance(1);say('Aoi beristirahat. Mood kembali membaik. 🧸');render()};
document.querySelectorAll('[data-look]').forEach(b=>b.onclick=()=>{s.look=b.dataset.look;s.mood=Math.min(100,s.mood+2);say('Aoi mencoba ekspresi baru! 💕');render()});
function move(dx,dy){if(s.hour>=22)return say('Aoi sudah mengantuk. Tidur dulu!');s.x=Math.max(12,Math.min(88,s.x+dx));advance(0);say('Aoi berjalan-jalan di '+places[s.place][0]+' 🌸')}
$('left').onclick=()=>move(-7,0);$('right').onclick=()=>move(7,0);$('up').onclick=()=>move(0,-1);$('down').onclick=()=>move(0,1);
$('wave').onclick=()=>{s.mood=Math.min(100,s.mood+3);say('Aoi melambaikan tangan. Haiii! 👋');render()};
$('dance').onclick=()=>{s.mood=Math.min(100,s.mood+7);$('aoi').animate([{transform:'translateX(-50%) rotate(-8deg)'},{transform:'translateX(-50%) rotate(8deg)'},{transform:'translateX(-50%) rotate(0)'}],{duration:550});say('Aoi menari dengan riang! 💃');render()};
$('newday').onclick=()=>{s.day++;s.hour=8;s.place='home';s.x=50;s.mood=Math.min(100,s.mood+20);say('🌅 Hari baru! Aoi bangun dengan semangat.');render()};
document.addEventListener('keydown',e=>{if(e.key==='ArrowLeft')move(-5,0);if(e.key==='ArrowRight')move(5,0);if(e.key==='ArrowUp')move(0,-1);if(e.key==='ArrowDown')move(0,1)});
render();
})();
</script>
</body></html>
